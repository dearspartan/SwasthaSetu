# SwasthaSetu Environment Configuration (Sample)

# Google Gemini API Key (Required for Multimodal Reasoning, Vision OCR, Audio STT/TTS)
# Obtain your key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=AIzaSy_SAMPLE_GEMINI_API_KEY_HERE

# Supabase Credentials (Required for Live OPD Queue & Session Sync)
# Obtain from your Supabase Project Dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# Optional: Alternative LLM Fallback (OpenRouter)
# VITE_OPENROUTER_API_KEY=sk-or-v1-sample-key-here
